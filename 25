def f(a, k, fs, step):
    if (a+k)>=81:
        return fs%2==step%2
    if fs==step:
        return False
    step+=1
    h=[
        f(a+1, k, fs, step),
        f(a, k+1, fs, step),
        f(a*3, k, fs, step),
        f(a, k*3, fs, step)
    ]
    if fs%2==step%2:
        return any(h)
    else:
        return all(h)
print(19, [a for a in range(1, 74) if f(a, 7, 2, 0)])
print(20, [a for a in range(1, 74) if not f(a, 7, 1, 0) and f(a, 7, 3, 0)])
print(21, [a for a in range(1, 74) if not f(a, 7, 2, 0) and f(a, 7, 4, 0)])

def check_valid_program(events_chosen, case):
    # Sort events by start time
    events_chosen = sorted(events_chosen, key=lambda x: x['start'])
    
    # Check count: 3 <= len <= max_events (4)
    if not (3 <= len(events_chosen) <= case['max_events']):
        return False, None, "Invalid event count"
        
    # Check budget
    total_price = sum(e['price'] for e in events_chosen)
    if total_price > case['budget']:
        return False, None, f"Budget exceeded: {total_price} > {case['budget']}"
        
    # Check must_attend
    chosen_ids = {e['id'] for e in events_chosen}
    for m in case['must_attend']:
        if m not in chosen_ids:
            return False, None, f"Must attend {m} missing"
            
    # Check excluded_tags
    excluded = set(case['excluded_tags'])
    for e in events_chosen:
        if not e['tags'].isdisjoint(excluded):
            return False, None, f"Event {e['id']} has excluded tag"
            
    # Check availability
    avail_from = time_to_min(case['available_from'])
    avail_to = time_to_min(case['available_to'])
    for e in events_chosen:
        if e['start'] < avail_from or e['end'] > avail_to:
            return False, None, f"Event {e['id']} out of availability"
            
    # Check time overlap and transitions between consecutive events
    for i in range(len(events_chosen) - 1.0): # wait, int range
        pass
        
    for i in range(len(events_chosen) - 1):
        e1 = events_chosen[i]
        e2 = events_chosen[i+1]
        trans = transitions[(e1['venue'], e2['venue'])]
        if e1['end'] + trans > e2['start']:
            return False, None, f"Overlap or insufficient transition between {e1['id']} and {e2['id']}"
            
    # Check min distinct venues (FEST-01 requires >= 2)
    venues = {e['venue'] for e in events_chosen}
    if len(venues) < 2:
        return False, None, f"Not enough distinct venues: {venues}"
        
    # Check lunch: must find at least one valid lunch start between 12:00 (720) and 14:00 (840) step 5
    valid_lunch = None
    for L in range(720, 841, 5):
        L_end = L + 30
        if L < avail_from or L_end > avail_to:
            continue
        # Check no overlap with any event
        overlap = False
        for e in events_chosen:
            # lunch overlaps with event if not (L_end <= e['start'] or L >= e['end'])
            if not (L_end <= e['start'] or L >= e['end']):
                overlap = True
                break
        if overlap:
            continue
            
        # If lunch is between two events (or before first, or after last)
        # Find event immediately preceding lunch (if any) and immediately following lunch (if any)
        prev_e = None
        next_e = None
        for e in events_chosen:
            if e['end'] <= L:
                if prev_e is None or e['end'] > prev_e['end']:
                    prev_e = e
            if e['start'] >= L_end:
                if next_e is None or e['start'] < next_e['start']:
                    next_e = e
                    
        # If both prev_e and next_e exist and are adjacent in events_chosen (i.e. next_e is the immediate successor of prev_e)
        # Check transition between prev_e and next_e through lunch
        ok_transition = True
        if prev_e is not None and next_e is not None:
            # Check if prev_e and next_e are adjacent in events_chosen
            idx_prev = events_chosen.index(prev_e)
            idx_next = events_chosen.index(next_e)
            if idx_next == idx_prev + 1:
                # Lunch is between prev_e and next_e
                # Visitor finishes prev_e at prev_e['end'], stays at prev_e['venue'] until L (or lunch starts at L),
                # lunch is [L, L+30], then travels from prev_e['venue'] to next_e['venue'] taking transitions[...], must arrive by next_e['start'].
                trans_lunch = transitions[(prev_e['venue'], next_e['venue'])]
                if L_end + trans_lunch > next_e['start']:
                    ok_transition = False
        
        if ok_transition:
            valid_lunch = min_to_time(L)
            break
            
    if valid_lunch is None:
        return False, None, "No valid lunch time found"
        
    return True, valid_lunch, "OK"


def time_to_min(t_str):
    h, m = map(int, t_str.split(':'))
    h = h - 24 if h >= 24 else h # handle if any, but 09:00 to 18:15
    return h * 60 + m

def min_to_time(m):
    return f"{m//60:02d}:{m%60:02d}"

transitions = {
    ('Альфа', 'Альфа'): 0,
    ('Бета', 'Бета'): 0,
    ('Гамма', 'Гамма'): 0,
    ('Альфа', 'Бета'): 8,
    ('Бета', 'Альфа'): 8,
    ('Альфа', 'Гамма'): 16,
    ('Гамма', 'Альфа'): 16,
    ('Бета', 'Гамма'): 10,
    ('Гамма', 'Бета'): 10
}

# Load events and apply updates
events_data = []
# let's parse df
updates_dict = {c['id']: c for c in updates['changes']}

for idx, row in df.iterrows():
    eid = row['id']
    if eid == 'E09' and updates_dict.get('E09', {}).get('cancelled'):
        continue
    title = row['title']
    start = time_to_min(row['start'])
    end = time_to_min(row['end'])
    venue = row['venue']
    price = row['price']
    tags = set(row['tags'].split('|'))
    
    if eid in updates_dict:
        up = updates_dict[eid]
        if 'venue' in up:
            venue = up['venue']
        if 'price' in up:
            price = up['price']
            
    events_data.append({
        'id': eid,
        'title': title,
        'start': start,
        'end': end,
        'venue': venue,
        'price': price,
        'tags': tags
    })

print(f"Total active events: {len(events_data)}")



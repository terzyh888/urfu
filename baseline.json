def calculate_score(events_chosen, tag_weights):
    score = 0
    for e in events_chosen:
        for t in e['tags']:
            if t in tag_weights:
                score += tag_weights[t]
    return score

results = []

for case in cases_json:
    print(f"\nSolving for {case['id']} ({case['persona']})...")
    best_prog = None
    best_score = -1
    best_price = 999
    best_lunch = None
    
    # Filter events that don't have excluded tags and within availability
    avail_from = time_to_min(case['available_from'])
    avail_to = time_to_min(case['available_to'])
    excluded = set(case['excluded_tags'])
    
    valid_pool = []
    for e in events_data:
        if not e['tags'].isdisjoint(excluded):
            continue
        if e['start'] < avail_from or e['end'] > avail_to:
            continue
        valid_pool.append(e)
        
    must = case['must_attend']
    
    # Generate combinations of 3 and 4 events
    found_any = False
    for r in [3, 4]:
        for comb in itertools.combinations(valid_pool, r):
            # Must include all must_attend
            comb_ids = {e['id'] for e in comb}
            if not all(m in comb_ids for m in must):
                continue
                
            is_valid, lunch_time, reason = check_valid_program(list(comb), case)
            if is_valid:
                score = calculate_score(comb, case['tag_weights'])
                price = sum(e['price'] for e in comb)
                ids_sorted = sorted([e['id'] for e in comb])
                
                # Compare with best
                # Maximize score, then minimize price, then lexicographically smaller ids
                better = False
                if best_prog is None:
                    better = True
                else:
                    if score > best_score:
                        better = True
                    elif score == best_score:
                        if price < best_price:
                            better = True
                        elif price == best_price:
                            if ids_sorted < sorted([e['id'] for e in best_prog]):
                                better = True
                if better:
                    best_prog = list(comb)
                    best_score = score
                    best_price = price
                    best_lunch = lunch_time
                    found_any = True
                    
    if found_any:
        print(f"  Found valid! IDs: {[e['id'] for e in sorted(best_prog, key=lambda x: x['start'])]}, Score: {best_score}, Price: {best_price}, Lunch: {best_lunch}")
        results.append({
            "id": case['id'],
            "status": "PLAN",
            "event_ids": sorted([e['id'] for e in best_prog]), # Wait, should event_ids be sorted by start time or lexical? Let's check common_request.md or rules.
            "lunch_start": best_lunch,
            "reason": f"Программа составлена с максимальным интересом ({best_score}), учтены все обязательные мероприятия и ограничения."
        })
    else:
        print(f"  IMPOSSIBLE")
        results.append({
            "id": case['id'],
            "status": "IMPOSSIBLE",
            "event_ids": [],
            "lunch_start": None,
            "reason": "Невозможно составить программу, удовлетворяющую всем жестким ограничениям."
        })

print(json.dumps(results, ensure_ascii=False, indent=2))


